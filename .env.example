# Local Docker Postgres + Redis: docker compose up -d
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
DATABASE_URL="postgresql://dokandari:dokandari@localhost:5432/dokandari?schema=public"
DIRECT_URL="postgresql://dokandari:dokandari@localhost:5432/dokandari?schema=public"
REDIS_URL="redis://localhost:6379"
SESSION_SECRET="replace-with-32-plus-char-secret-key!!"
ADMIN_PIN="123456"

